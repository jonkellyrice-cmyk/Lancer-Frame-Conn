{
  "name": "Remove duplicate automatic Overcharge warning panel",
  "backup": true,
  "operations": [
    {
      "file": "scripts/lancer-frame-helm.js",
      "operation": "replace",
      "find": "    const overchargeWarning = willTriggerOvercharge\n      ? `\n        <div class=\"frame-helm-overcharge-warning-panel\">\n          <i class=\"fas fa-triangle-exclamation\"></i>\n\n          <span>\n            Your normal action budget cannot perform this action. Continuing will automatically trigger Overcharge.\n          </span>\n        </div>\n      `\n      : \"\";\n\n    return `",
      "replace": "    return `",
      "expected_matches": 1
    },
    {
      "file": "scripts/lancer-frame-helm.js",
      "operation": "replace",
      "find": "        ${targetNotice}\n        ${overchargeWarning}\n\n        <div class=\"frame-helm-quick-execution-options\">",
      "replace": "        ${targetNotice}\n\n        <div class=\"frame-helm-quick-execution-options\">",
      "expected_matches": 1
    }
  ]
}
