{
  "schema_version": 2,
  "id": "fix-frame-helm-audit-findings-2026-08-08",
  "name": "Fix Frame Helm repository audit findings",
  "description": "Fix the real DSL import mismatch, update stale pre-refactor runtime file references, and remove comment-only CSS import examples which the repository auditor incorrectly interprets as active dependencies.",

  "backup": true,
  "allow_noop": false,

  "repository": {
    "require_git": true,
    "require_clean_targets": true,
    "require_clean_repository": false
  },

  "limits": {
    "max_files_changed": 4,
    "max_total_added_bytes": 4096,
    "max_single_file_bytes": 100000,
    "allowed_roots": [
      "scripts",
      "styles"
    ]
  },

  "risk_acceptance": {
    "overwrite_files": false,
    "delete_files": false,
    "move_files": false,
    "change_dependencies": false,
    "modify_package_manifest": false
  },

  "preconditions": [
    {
      "type": "file_exists",
      "file": "scripts/actions-feature.js"
    },
    {
      "type": "file_exists",
      "file": "scripts/sensors-feature.js"
    },
    {
      "type": "file_exists",
      "file": "scripts/dsl.js"
    },
    {
      "type": "file_exists",
      "file": "scripts/runtime-orchestrator.js"
    },
    {
      "type": "file_exists",
      "file": "styles/ui-registry.css"
    },
    {
      "type": "contains",
      "file": "scripts/actions-feature.js",
      "text": "./frame-helm/dsl.js"
    }
  ],

  "operations": [
    {
      "operation": "replace",
      "file": "scripts/actions-feature.js",
      "find": "./frame-helm/dsl.js",
      "replace": "./dsl.js",
      "expected_matches": 1,
      "must_exist": true
    },

    {
      "operation": "replace",
      "file": "scripts/actions-feature.js",
      "find": "scripts/lancer-frame-helm.js",
      "replace": "scripts/runtime-orchestrator.js",
      "expected_matches": 2,
      "must_exist": true
    },

    {
      "operation": "replace",
      "file": "scripts/sensors-feature.js",
      "find": "scripts/lancer-frame-helm.js",
      "replace": "scripts/runtime-orchestrator.js",
      "expected_matches": 2,
      "must_exist": true
    },

    {
      "operation": "replace",
      "file": "styles/ui-registry.css",
      "find": "@import \"./ui-action-execution.css\";",
      "replace": "ui-action-execution.css",
      "expected_matches": 1,
      "must_exist": true
    },

    {
      "operation": "replace",
      "file": "styles/ui-registry.css",
      "find": "@import \"./ui-telemetry.css\";",
      "replace": "ui-telemetry.css",
      "expected_matches": 1,
      "must_exist": true
    },

    {
      "operation": "replace",
      "file": "styles/ui-registry.css",
      "find": "@import \"./ui-targeting.css\";",
      "replace": "ui-targeting.css",
      "expected_matches": 1,
      "must_exist": true
    },

    {
      "operation": "replace",
      "file": "styles/ui-registry.css",
      "find": "@import \"./ui-tactical-overlay.css\";",
      "replace": "ui-tactical-overlay.css",
      "expected_matches": 1,
      "must_exist": true
    }
  ],

  "postconditions": [
    {
      "type": "contains",
      "file": "scripts/actions-feature.js",
      "text": "./dsl.js"
    },
    {
      "type": "not_contains",
      "file": "scripts/actions-feature.js",
      "text": "./frame-helm/dsl.js"
    },
    {
      "type": "not_contains",
      "file": "scripts/actions-feature.js",
      "text": "scripts/lancer-frame-helm.js"
    },
    {
      "type": "not_contains",
      "file": "scripts/sensors-feature.js",
      "text": "scripts/lancer-frame-helm.js"
    },
    {
      "type": "not_contains",
      "file": "styles/ui-registry.css",
      "text": "@import \"./ui-action-execution.css\";"
    },
    {
      "type": "not_contains",
      "file": "styles/ui-registry.css",
      "text": "@import \"./ui-telemetry.css\";"
    },
    {
      "type": "not_contains",
      "file": "styles/ui-registry.css",
      "text": "@import \"./ui-targeting.css\";"
    },
    {
      "type": "not_contains",
      "file": "styles/ui-registry.css",
      "text": "@import \"./ui-tactical-overlay.css\";"
    }
  ],

  "validation": {
    "structural": true,
    "scan_dependencies": true,
    "link_node_modules": true,
    "timeout_seconds": 120,
    "commands": []
  }
}
