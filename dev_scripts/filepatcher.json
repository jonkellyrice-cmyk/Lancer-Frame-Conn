{
  "schema_version": 2,
  "id": "frame-helm-foundational-facade-reconciliation-v1",
  "name": "Reconcile foundational public facade exports",
  "description": "Fix the application-level import/export mismatches found during the pre-system-bridge repository audit by exposing shared execution hook, resource operation, and semantic event vocabulary through their intended public facade modules.",
  "backup": true,
  "allow_noop": false,
  "repository": {
    "require_git": true,
    "require_clean_targets": true,
    "require_clean_repository": false
  },
  "risk_acceptance": {
    "overwrite_files": false,
    "delete_files": false,
    "move_files": false,
    "change_dependencies": false,
    "modify_package_manifest": false
  },
  "limits": {
    "max_files_changed": 3,
    "max_total_added_bytes": 5000,
    "max_single_file_bytes": 250000,
    "allowed_roots": [
      "execution_transaction",
      "resource_service",
      "semantic_event_bus"
    ]
  },
  "preconditions": [
    {
      "type": "file_exists",
      "file": "execution_transaction/execution-transaction.js"
    },
    {
      "type": "file_exists",
      "file": "execution_transaction/execution-transaction-hooks.js"
    },
    {
      "type": "contains",
      "file": "execution_transaction/execution-transaction-hooks.js",
      "text": "export const EXECUTION_HOOK_PRIORITY"
    },
    {
      "type": "contains",
      "file": "execution_transaction/execution-transaction-hooks.js",
      "text": "export const EXECUTION_HOOK_SOURCE_KIND"
    },
    {
      "type": "not_contains",
      "file": "execution_transaction/execution-transaction.js",
      "text": "export {\n  EXECUTION_HOOK_PRIORITY,\n  EXECUTION_HOOK_SOURCE_KIND\n} from \"./execution-transaction-hooks.js\";"
    },

    {
      "type": "file_exists",
      "file": "resource_service/resource-service.js"
    },
    {
      "type": "file_exists",
      "file": "resource_service/resource-contract.js"
    },
    {
      "type": "contains",
      "file": "resource_service/resource-contract.js",
      "text": "export const RESOURCE_OPERATION"
    },
    {
      "type": "not_contains",
      "file": "resource_service/resource-service.js",
      "text": "export {\n  RESOURCE_OPERATION\n} from \"./resource-contract.js\";"
    },

    {
      "type": "file_exists",
      "file": "semantic_event_bus/semantic-event-bus.js"
    },
    {
      "type": "file_exists",
      "file": "semantic_event_bus/semantic-event-contract.js"
    },
    {
      "type": "file_exists",
      "file": "semantic_event_bus/semantic-event-registry.js"
    },
    {
      "type": "contains",
      "file": "semantic_event_bus/semantic-event-contract.js",
      "text": "export const SEMANTIC_EVENT_KIND"
    },
    {
      "type": "contains",
      "file": "semantic_event_bus/semantic-event-registry.js",
      "text": "export const SEMANTIC_EVENT_LISTENER_PRIORITY"
    },
    {
      "type": "contains",
      "file": "semantic_event_bus/semantic-event-registry.js",
      "text": "export const SEMANTIC_EVENT_LISTENER_SOURCE_KIND"
    },
    {
      "type": "not_contains",
      "file": "semantic_event_bus/semantic-event-bus.js",
      "text": "export {\n  SEMANTIC_EVENT_KIND\n} from \"./semantic-event-contract.js\";"
    },
    {
      "type": "not_contains",
      "file": "semantic_event_bus/semantic-event-bus.js",
      "text": "export {\n  SEMANTIC_EVENT_LISTENER_PRIORITY,\n  SEMANTIC_EVENT_LISTENER_SOURCE_KIND\n} from \"./semantic-event-registry.js\";"
    }
  ],
  "postconditions": [
    {
      "type": "contains",
      "file": "execution_transaction/execution-transaction.js",
      "text": "export {\n  EXECUTION_HOOK_PRIORITY,\n  EXECUTION_HOOK_SOURCE_KIND\n} from \"./execution-transaction-hooks.js\";"
    },
    {
      "type": "contains",
      "file": "resource_service/resource-service.js",
      "text": "export {\n  RESOURCE_OPERATION\n} from \"./resource-contract.js\";"
    },
    {
      "type": "contains",
      "file": "semantic_event_bus/semantic-event-bus.js",
      "text": "export {\n  SEMANTIC_EVENT_KIND\n} from \"./semantic-event-contract.js\";"
    },
    {
      "type": "contains",
      "file": "semantic_event_bus/semantic-event-bus.js",
      "text": "export {\n  SEMANTIC_EVENT_LISTENER_PRIORITY,\n  SEMANTIC_EVENT_LISTENER_SOURCE_KIND\n} from \"./semantic-event-registry.js\";"
    }
  ],
  "validation": {
    "structural": true,
    "scan_dependencies": true,
    "commands": [
      [
        "node",
        "--check",
        "execution_transaction/execution-transaction.js"
      ],
      [
        "node",
        "--check",
        "resource_service/resource-service.js"
      ],
      [
        "node",
        "--check",
        "semantic_event_bus/semantic-event-bus.js"
      ],
      [
        "node",
        "--check",
        "action_economy/action-economy-hooks.js"
      ],
      [
        "node",
        "--check",
        "resource_service/resource-hooks.js"
      ],
      [
        "node",
        "--check",
        "semantic_event_bus/semantic-event-hooks.js"
      ],
      [
        "node",
        "--check",
        "lifecycle_service/lifecycle-hooks.js"
      ],
      [
        "node",
        "--check",
        "lifecycle_service/lifecycle-dispatcher.js"
      ],
      [
        "node",
        "--check",
        "targeting-spatial_service/targeting-spatial-hooks.js"
      ]
    ],
    "timeout_seconds": 60
  },
  "operations": [
    {
      "operation": "append",
      "file": "execution_transaction/execution-transaction.js",
      "content": "\n/* ============================================================\n   PUBLIC CONTRACT / HOOK VOCABULARY RE-EXPORTS\n   ============================================================ */\n\n/**\n * Shared execution hook vocabulary is exposed through the public\n * execution_transaction facade so downstream foundational services do not\n * need to bypass the package boundary.\n */\nexport {\n  EXECUTION_HOOK_PRIORITY,\n  EXECUTION_HOOK_SOURCE_KIND\n} from \"./execution-transaction-hooks.js\";\n"
    },
    {
      "operation": "append",
      "file": "resource_service/resource-service.js",
      "content": "\n/* ============================================================\n   PUBLIC CONTRACT VOCABULARY RE-EXPORTS\n   ============================================================ */\n\n/**\n * Shared resource operation vocabulary is exposed through the public\n * resource_service facade for lifecycle and future bridge consumers.\n */\nexport {\n  RESOURCE_OPERATION\n} from \"./resource-contract.js\";\n"
    },
    {
      "operation": "append",
      "file": "semantic_event_bus/semantic-event-bus.js",
      "content": "\n/* ============================================================\n   PUBLIC SEMANTIC EVENT VOCABULARY RE-EXPORTS\n   ============================================================ */\n\n/**\n * Shared semantic event vocabulary is exposed through the public event-bus\n * facade so lifecycle, targeting, and future bridge consumers remain on the\n * package boundary.\n */\nexport {\n  SEMANTIC_EVENT_KIND\n} from \"./semantic-event-contract.js\";\n\nexport {\n  SEMANTIC_EVENT_LISTENER_PRIORITY,\n  SEMANTIC_EVENT_LISTENER_SOURCE_KIND\n} from \"./semantic-event-registry.js\";\n"
    }
  ]
}