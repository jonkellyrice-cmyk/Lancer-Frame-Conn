    },
    {
      "from": "scripts/player_features/feature-registry-core.js",
      "to": "scripts/feature-registry-core.js"
    },
    {
      "from": "scripts/player_features/feature-registry.js",
      "to": "scripts/player_features/player-feature-registry.js"
