{
  "schema_version": 1,
  "id": "promote-runtime-orchestrator-to-scripts-root",
  "enabled": true,
  "description": "Move runtime-orchestrator.js from player_features to scripts so it can serve as the composition root for player_features and rules_features while automatically rewriting relative imports and operational path references.",
  "moves": [
    {
      "from": "scripts/player_features/runtime-orchestrator.js",
      "to": "scripts/runtime-orchestrator.js"
    }
  ],
  "reference_rewrites": [
    {
      "path": "module.json",
      "from": "scripts/player_features/runtime-orchestrator.js",
      "to": "scripts/runtime-orchestrator.js",
      "expected_occurrences": 1
    },
    {
      "path": "dev_scripts/repo-audit.mjs",
      "from": "scripts/player_features/runtime-orchestrator.js",
      "to": "scripts/runtime-orchestrator.js"
    }
  ]
}
