{
  "schema_version": 2,
  "id": "hotfix-elevation-los-module-id-imports",
  "description": "Restore the canonical MODULE_ID contract import in decomposed Elevation/LOS services that reference it during Foundry init.",
  "policy": {
    "max_files_changed": 2,
    "allowed_paths": [
      "scripts/foundry_features/elevation_los/elevation-vision-service.js",
      "scripts/foundry_features/elevation_los/elevated-light-service.js"
    ]
  },
  "operations": [
    {
      "type": "replace_text",
      "path": "scripts/foundry_features/elevation_los/elevation-vision-service.js",
      "search": "import {\n  finiteNumberOr\n} from \"./elevation-los-contract.js\";",
      "replace": "import {\n  MODULE_ID,\n  finiteNumberOr\n} from \"./elevation-los-contract.js\";",
      "expected_occurrences": 1
    },
    {
      "type": "replace_text",
      "path": "scripts/foundry_features/elevation_los/elevated-light-service.js",
      "search": "import {\n  finiteNumberOr\n} from \"./elevation-los-contract.js\";",
      "replace": "import {\n  MODULE_ID,\n  finiteNumberOr\n} from \"./elevation-los-contract.js\";",
      "expected_occurrences": 1
    }
  ]
}
