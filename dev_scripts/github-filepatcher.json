{
  "schema_version": 2,
  "id": "frame-helm-sidebar-default-presentation",
  "description": "Make the per-user Frame Helm presentation setting default to Sidebar while preserving Window as an available toggle choice.",
  "policy": {
    "max_files_changed": 1,
    "allowed_paths": [
      "scripts/foundry-integration-feature.js"
    ]
  },
  "operations": [
    {
      "type": "replace_text",
      "path": "scripts/foundry-integration-feature.js",
      "search": "      default:\n        \"window\",\n\n      restricted:\n        false,\n\n      onChange:\n        handleFrameConnPresentationModeSettingChange",
      "replace": "      default:\n        \"sidebar\",\n\n      restricted:\n        false,\n\n      onChange:\n        handleFrameConnPresentationModeSettingChange",
      "expected_occurrences": 1
    }
  ]
}
