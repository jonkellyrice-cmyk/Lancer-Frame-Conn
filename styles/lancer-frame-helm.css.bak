.lancer-frame-helm .window-content {
  padding: 0;
  overflow: hidden auto;
}

.frame-helm-shell {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  min-height: 280px;
  padding: 1rem;
}

.frame-helm-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2px solid var(--color-border-highlight, #782e22);
  padding-bottom: 0.75rem;
}

.frame-helm-header h2 {
  margin: 0;
  font-size: 1.4rem;
}

.frame-helm-eyebrow {
  margin: 0 0 0.2rem;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  opacity: 0.7;
}

.frame-helm-selected-actor {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  border: 1px solid var(--color-border-light-2, #7a7971);
  border-radius: 4px;
  padding: 0.75rem;
}

.frame-helm-label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.7;
}

.frame-helm-token-name {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 700;
}

.frame-helm-empty-state {
  margin: 0;
  font-style: italic;
  opacity: 0.8;
}

.frame-helm-placeholder {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  min-height: 140px;
  border: 1px dashed var(--color-border-light-2, #7a7971);
  border-radius: 4px;
  padding: 1.5rem;
  text-align: center;
  opacity: 0.8;
}

.frame-helm-placeholder i {
  font-size: 2rem;
}

.frame-helm-placeholder p {
  margin: 0;
  max-width: 260px;
}
