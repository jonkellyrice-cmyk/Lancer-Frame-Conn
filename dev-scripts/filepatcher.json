{
  "schema_version": 2,
  "id": "update-repository-urls-for-frame-conn",
  "description": "Update canonical repository URLs in module.json after renaming the GitHub repository to Lancer-Frame-Conn while preserving the existing Foundry module id lancer-frame-helm.",
  "policy": {
    "max_files_changed": 1
  },
  "operations": [
    {
      "type": "replace_text",
      "path": "module.json",
      "search": "  \"manifest\": \"https://raw.githubusercontent.com/jonkellyrice-cmyk/lancer-frame-helm/main/module.json\",\n\n  \"download\": \"https://github.com/jonkellyrice-cmyk/lancer-frame-helm/archive/refs/heads/main.zip\"",
      "replace": "  \"manifest\": \"https://raw.githubusercontent.com/jonkellyrice-cmyk/Lancer-Frame-Conn/main/module.json\",\n\n  \"download\": \"https://github.com/jonkellyrice-cmyk/Lancer-Frame-Conn/archive/refs/heads/main.zip\"",
      "expected_occurrences": 1
    }
  ]
}
