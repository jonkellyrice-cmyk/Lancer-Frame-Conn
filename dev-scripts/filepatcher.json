{
  "schema_version": 2,
  "id": "fix-execution-context-module-namespace-freeze",
  "description": "Prevent the Semantic Execution Context facade from freezing ES module namespace objects during import while preserving the frozen outer executionContext namespace.",
  "policy": {
    "max_files_changed": 1
  },
  "operations": [
    {
      "type": "replace_text",
      "path": "semantic_execution_context/execution-context.js",
      "search": "    contract:\n      Object.freeze(contract),\n\n    builder:\n      Object.freeze(builder)",
      "replace": "    contract,\n    builder",
      "expected_occurrences": 1
    }
  ]
}
