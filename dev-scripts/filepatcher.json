{
  "schema_version": 2,
  "id": "add-change-propagation-scripts",
  "description": "Expose the Change Propagation Simulator through Frame Conn package scripts.",
  "policy": {
    "max_files_changed": 1,
    "allowed_paths": ["package.json"]
  },
  "operations": [
    {
      "type": "replace_text",
      "path": "package.json",
      "search": "    \"runtime-probes\": \"node ./dev_scripts/runtime-contract-probes.mjs\",\n    \"runtime-probes:self-test\": \"node ./dev_scripts/runtime-contract-probes.mjs --self-test\",",
      "replace": "    \"runtime-probes\": \"node ./dev_scripts/runtime-contract-probes.mjs\",\n    \"runtime-probes:self-test\": \"node ./dev_scripts/runtime-contract-probes.mjs --self-test\",\n    \"change-propagation\": \"node ./dev_scripts/change-propagation-simulator.mjs\",\n    \"change-propagation:self-test\": \"node ./dev_scripts/change-propagation-simulator.mjs --self-test\","
    }
  ]
}
