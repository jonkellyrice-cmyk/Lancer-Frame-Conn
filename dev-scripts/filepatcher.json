{
  "schema_version": 2,
  "id": "add-compact-patch-authoring-dsl",
  "description": "Add a small standalone Patch DSL compiler that compresses repetitive FilePatcher authoring into deterministic schema-v2 JSON while leaving github-filepatcher.mjs as the sole executor and safety boundary.",
  "policy": {
    "max_files_changed": 4
  },
  "operations": [
    {
      "type": "create_file",
      "path": "dev_scripts/patch-dsl-compiler.mjs",
      "encoding": "base64",
      "content": ""
    },
    {
      "type": "create_file",
      "path": "dev_scripts/PATCH_DSL.md",
      "encoding": "base64",
      "content": ""
    },
    {
      "type": "replace_text",
      "path": "package.json",
      "search": "    \"patch-corridor\": \"node ./dev_scripts/patch-corridor-planner.mjs\",\n    \"dependency-graph\": \"python ./dev_scripts/dependency_graph.py\"",
      "replace": "    \"patch-corridor\": \"node ./dev_scripts/patch-corridor-planner.mjs\",\n    \"patch:dsl\": \"node ./dev_scripts/patch-dsl-compiler.mjs\",\n    \"patch:dsl:check\": \"node ./dev_scripts/patch-dsl-compiler.mjs --check\",\n    \"patch:dsl:self-test\": \"node ./dev_scripts/patch-dsl-compiler.mjs --self-test\",\n    \"dependency-graph\": \"python ./dev_scripts/dependency_graph.py\"",
      "expected_occurrences": 1
    },
    {
      "type": "replace_text",
      "path": "dev-scripts/github-filepatcher.mjs",
      "search": "    path.join(ROOT, \"dev_scripts\", \"effect-atlas.mjs\"),\n    path.join(ROOT, \"dev_scripts\", \"patch-corridor-planner.mjs\")",
      "replace": "    path.join(ROOT, \"dev_scripts\", \"effect-atlas.mjs\"),\n    path.join(ROOT, \"dev_scripts\", \"patch-corridor-planner.mjs\"),\n    path.join(ROOT, \"dev_scripts\", \"patch-dsl-compiler.mjs\")",
      "expected_occurrences": 1
    },
    {
      "type": "replace_text",
      "path": "dev-scripts/github-filepatcher.mjs",
      "search": "  console.log(\"[github-filepatcher] Developer tool syntax checks passed.\");\n}",
      "replace": "  const dslCompiler = path.join(ROOT, \"dev_scripts\", \"patch-dsl-compiler.mjs\");\n  const dslSelfTest = spawnSync(process.execPath, [dslCompiler, \"--self-test\"], { cwd: ROOT, encoding: \"utf8\" });\n  if (dslSelfTest.stdout) process.stdout.write(dslSelfTest.stdout);\n  if (dslSelfTest.stderr) process.stderr.write(dslSelfTest.stderr);\n  if (dslSelfTest.error) fail(`Patch DSL self-test could not start: ${dslSelfTest.error}`);\n  if (dslSelfTest.status !== 0) fail(\"Patch DSL self-test failed.\");\n\n  console.log(\"[github-filepatcher] Developer tool syntax checks passed.\");\n}",
      "expected_occurrences": 1
    }
  ]
}
