{
  "schema_version": 2,
  "id": "remove-manual-begin-turn-plan-control",
  "description": "Remove the manual Begin Turn Plan control and explain that Frame Helm starts turn tracking automatically from action interaction.",
  "policy": {
    "max_files_changed": 1
  },
  "operations": [
    {
      "type": "replace_text",
      "path": "styles/ui_application/components/application-budget-panel.js",
      "search": "    return `\n      <section class=\"frame-helm-budget frame-helm-budget-empty\">\n        <div class=\"frame-helm-budget-message\">\n          <i class=\"fas fa-circle-play\"></i>\n\n          <div>\n            <strong>\n              No turn plan is active.\n            </strong>\n\n            <p>\n              Begin a plan to track movement, actions, and Overcharge.\n            </p>\n          </div>\n        </div>\n\n        <button\n          type=\"button\"\n          class=\"frame-helm-primary-button\"\n          data-frame-helm-command=\"begin-turn\"\n          ${data.hasSelectedToken ? \"\" : \"disabled\"}\n        >\n          <i class=\"fas fa-play\"></i>\n          Begin Turn Plan\n        </button>\n      </section>\n    `;",
      "replace": "    return `\n      <section class=\"frame-helm-budget frame-helm-budget-empty\">\n        <div class=\"frame-helm-budget-message\">\n          <i class=\"fas fa-bolt\"></i>\n\n          <div>\n            <strong>\n              Turn plan ready.\n            </strong>\n\n            <p>\n              Choose an action and Frame Helm will begin tracking the turn automatically.\n            </p>\n          </div>\n        </div>\n      </section>\n    `;",
      "expected_occurrences": 1
    }
  ]
}
