{
  "schema_version": 2,
  "id": "rename-ui-branding-to-pilot-conn",
  "description": "Rename user-facing Frame Helm branding to Pilot Conn while preserving internal module ids, feature ids, CSS classes, public APIs, and repository URLs.",
  "policy": {
    "max_files_changed": 3
  },
  "operations": [
    {
      "type": "replace_text",
      "path": "styles/ui_application/ui-application.js",
      "search": "const MODULE_TITLE =\n  \"Lancer: Frame Helm\";",
      "replace": "const MODULE_TITLE =\n  \"Pilot Conn\";",
      "expected_occurrences": 1
    },
    {
      "type": "replace_text",
      "path": "scripts/foundry-integration-feature.js",
      "search": "const MODULE_TITLE =\n  \"Lancer: Frame Helm\";",
      "replace": "const MODULE_TITLE =\n  \"Pilot Conn\";",
      "expected_occurrences": 1
    },
    {
      "type": "replace_text",
      "path": "scripts/foundry-integration-feature.js",
      "search": "      name:\n        \"Enable Frame Helm\",\n\n      hint:\n        \"Enables the Frame Helm action-selection interface.\",",
      "replace": "      name:\n        \"Enable Pilot Conn\",\n\n      hint:\n        \"Enables the Pilot Conn action-selection interface.\",",
      "expected_occurrences": 1
    },
    {
      "type": "replace_text",
      "path": "module.json",
      "search": "  \"title\": \"Lancer Frame Helm\",",
      "replace": "  \"title\": \"Pilot Conn\",",
      "expected_occurrences": 1
    }
  ]
}
