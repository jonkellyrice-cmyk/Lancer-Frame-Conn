{
  "schema_version": 2,
  "id": "calibrate-effect-atlas-native-verification",
  "description": "Refine the Effect Atlas native-execution detector so explicit verification, verifier, probe, and check helpers are treated as observational rather than mutating native execution.",
  "policy": {
    "max_files_changed": 1
  },
  "operations": [
    {
      "type": "replace_text",
      "path": "dev_scripts/effect-atlas.mjs",
      "search": "    regex: /\\b(?:executeNative[A-Za-z0-9_$]*|runNative[A-Za-z0-9_$]*|rollNative[A-Za-z0-9_$]*)\\s*\\(/g",
      "replace": "    regex: /\\b(?:(?:execute|run|roll)Native(?![A-Za-z0-9_$]*(?:Verification|Verifier|Probe|Check)\\b)[A-Za-z0-9_$]*)\\s*\\(/g",
      "expected_occurrences": 1
    }
  ]
}
