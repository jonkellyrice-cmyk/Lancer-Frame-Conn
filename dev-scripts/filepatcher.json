{
  "schema_version": 2,
  "id": "migrate-live-internal-identity-to-frame-conn",
  "description": "Rename the live Frame Helm internal identity to Frame Conn across runtime code, styles, active docs, and active tooling while excluding historical backups, patch-history records, generated reports, and legacy .bak snapshots.",
  "policy": {
    "max_files_changed": 160
  },
  "operations": [
    {
      "type": "replace_tree_text",
      "roots": [
        "module.json",
        "scripts",
        "styles",
        "action_economy",
        "actor_owned_feature_registry",
        "execution_transaction",
        "lifecycle_service",
        "native_adapter",
        "resource_service",
        "semantic_event_bus",
        "semantic_execution_context",
        "system_bridge",
        "targeting-spatial_service",
        "Docs",
        "dev-scripts/README.md",
        "dev_scripts/filepatcher-bootstrap.md",
        "dev_scripts/dependency_graph.py",
        "dev_scripts/filepatcher.py",
        "dev_scripts/repo-audit.mjs"
      ],
      "excludes": [
        "dev_scripts/backups",
        "dev_scripts/patch-history",
        "scripts/lancer-frame-helm.js.bak",
        "styles/lancer-frame-helm.css.bak",
        "repo-audit-report.json",
        "dev_scripts/dependency-graph-report.json",
        "dev_scripts/filepatcher.json",
        "dev-scripts/filepatcher.json"
      ],
      "extensions": [
        ".js",
        ".mjs",
        ".css",
        ".json",
        ".md",
        ".py"
      ],
      "require_each_search": false,
      "replacements": [
        {
          "search": "Lancer: Frame Helm",
          "replace": "Frame Conn"
        },
        {
          "search": "Lancer Frame Helm",
          "replace": "Frame Conn"
        },
        {
          "search": "lancer-frame-helm",
          "replace": "lancer-frame-conn"
        },
        {
          "search": "lancerFrameHelm",
          "replace": "lancerFrameConn"
        },
        {
          "search": "FrameHelm",
          "replace": "FrameConn"
        },
        {
          "search": "frameHelm",
          "replace": "frameConn"
        },
        {
          "search": "FRAME_HELM",
          "replace": "FRAME_CONN"
        },
        {
          "search": "frame-helm",
          "replace": "frame-conn"
        },
        {
          "search": "Frame Helm",
          "replace": "Frame Conn"
        },
        {
          "search": "FRAME HELM",
          "replace": "FRAME CONN"
        },
        {
          "search": "fh-",
          "replace": "fc-"
        }
      ],
      "assert_absent": [
        "Lancer: Frame Helm",
        "Lancer Frame Helm",
        "lancer-frame-helm",
        "lancerFrameHelm",
        "FrameHelm",
        "frameHelm",
        "FRAME_HELM",
        "frame-helm",
        "Frame Helm",
        "FRAME HELM",
        "fh-"
      ]
    }
  ]
}
